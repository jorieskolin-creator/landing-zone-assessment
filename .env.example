# Copy to .env.local for `vercel dev`, or export these variables before running
# the Node server directly. Configure the same secrets in the deployment platform.
# Never commit populated environment files.

# Auth: doubles as the shared login password AND HMAC signing key for the
# session cookie. Rotating it invalidates all active sessions.
SECRET_KEY=

# Active LLM providers (server-side only — never exposed to the browser).
# GPT_API_KEY is accepted as an alternative name for OPENAI_API_KEY.
# GOOGLE_API_KEY is accepted as an alternative name for GEMINI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# TEST_MODE must be exactly "true" or "false". Unset means false. Any other
# value fails startup. When true, the twelve role variables below are ignored:
#   WORKHORSE:        GOOGLE gemini-3.8-flash → XAI grok-4.6
#   REASONER:         XAI grok-4.6 → GOOGLE gemini-3.8-flash
#   QUALITY_CHECKER:  GOOGLE gemini-3.8-flash → XAI grok-4.6
# TEST_MODE startup requires Gemini (GEMINI_API_KEY or GOOGLE_API_KEY) and xAI.
TEST_MODE=false

# Required server-side AI-role routing when TEST_MODE is not true. Configure
# every field as one complete policy; partial policies fail startup.
# Authorized providers: ANTHROPIC, GOOGLE, OPENAI, XAI.
# Authorized model IDs:
#   OPENAI:     gpt-6.2-sol, gpt-6.1-terra, gpt-6-astra, gpt-5.6-sol, gpt-5.6-terra, gpt-5.4
#   GOOGLE:     gemini-4-carbon, gemini-4-neon, gemini-4-hydrogen, gemini-3.8-flash
#   XAI:        grok-4.7, grok-4.6
#   ANTHROPIC:  claude-sonnet-5
#
# Landing Zone Assessment role routing:
REASONER_PROVIDER=GOOGLE
REASONER_MODEL=gemini-4-carbon
REASONER_FALLBACK_PROVIDER=OPENAI
REASONER_FALLBACK_MODEL=gpt-6.2-sol

WORKHORSE_PROVIDER=GOOGLE
WORKHORSE_MODEL=gemini-4-carbon
WORKHORSE_FALLBACK_PROVIDER=OPENAI
WORKHORSE_FALLBACK_MODEL=gpt-6.1-terra

QUALITY_CHECKER_PROVIDER=OPENAI
QUALITY_CHECKER_MODEL=gpt-6.1-terra
QUALITY_CHECKER_FALLBACK_PROVIDER=XAI
QUALITY_CHECKER_FALLBACK_MODEL=grok-4.7

# Required by the long-lived Railway server. PostgreSQL is the content-free
# authoritative control plane; Redis holds deadline-bounded transient content.
DATABASE_URL=
REDIS_URL=

# Optional: Google Drive folder ID for LZ Assessment KB authoring (A–H
# letter folders plus PAIR-*.md companions). Agents use this to find
# authoring files. Runtime ingest remains Vercel Blob below. Do not
# point the engine at Drive at runtime. Do not add this to Railway for ingest.
GOOGLE_DRIVE_KB=

# Remote reference Knowledge Base in a Landing Zone Vercel Blob store.
# Use a dedicated Landing Zone Knowledge Base store. Copy the store
# token onto Railway as BLOB_READ_WRITE_TOKEN. Use the prefix below.
# Print exact pathnames with: node scripts/print-lz-kb-blob-layout.mjs
BLOB_READ_WRITE_TOKEN=
LZ_KB_BLOB_PREFIX=Landing Zone Knowledge Base/

# Server port — Railway and similar hosts set this automatically.
PORT=3000

# Set for a new deployment. For an existing Redis store, drain active runs and
# let all retained checkpoints expire before changing the namespace on every replica.
LZ_REDIS_NAMESPACE=landing-zone:v1
