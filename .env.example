# Copy to .env.local for `vercel dev`, or export these variables before running
# the Node server directly. Configure the same secrets in the deployment platform.
# Never commit populated environment files.

# Auth: doubles as the shared login password AND HMAC signing key for the
# session cookie. Rotating it invalidates all active sessions.
SECRET_KEY=

# Active LLM providers (server-side only — never exposed to the browser).
# GPT_API_KEY is accepted as an alternative name for OPENAI_API_KEY.
# GOOGLE_API_KEY is accepted as an alternative name for GEMINI_API_KEY.
# MODEL_API_KEY is accepted as an alternative name for META_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
META_API_KEY=

# TEST_MODE must be exactly "true" or "false". Unset means false. Any other
# value fails startup. When true, the twelve role variables below are ignored
# and the server uses Gemini 3.8 Flash, Grok 4.6, and Muse Spark 1.3
# Contributor with cheap fallbacks:
#   WORKHORSE:        GOOGLE gemini-3.8-flash → XAI grok-4.6
#   REASONER:         XAI grok-4.6 → GOOGLE gemini-3.8-flash
#   QUALITY_CHECKER:  META muse-spark-1.3-contributor → GOOGLE gemini-3.8-flash
TEST_MODE=false

# Required server-side AI-role routing when TEST_MODE is not true. Configure
# every field as one complete policy; partial policies fail startup.
# Authorized providers: ANTHROPIC, GOOGLE, META, OPENAI, XAI.
# Authorized model IDs:
#   OPENAI:     gpt-5.6-sol, gpt-5.6-terra, gpt-6-astra, gpt-5.4
#   GOOGLE:     gemini-3.8-flash
#   XAI:        grok-4.6
#   META:       muse-spark-1.3 (all roles); muse-spark-1.3-contributor (QUALITY_CHECKER)
#   ANTHROPIC:  claude-sonnet-5
#
# Recommended production routing (best quality, cross-provider fallbacks):
REASONER_PROVIDER=OPENAI
REASONER_MODEL=gpt-6-astra
REASONER_FALLBACK_PROVIDER=XAI
REASONER_FALLBACK_MODEL=grok-4.6

WORKHORSE_PROVIDER=OPENAI
WORKHORSE_MODEL=gpt-5.6-terra
WORKHORSE_FALLBACK_PROVIDER=GOOGLE
WORKHORSE_FALLBACK_MODEL=gemini-3.8-flash

QUALITY_CHECKER_PROVIDER=META
QUALITY_CHECKER_MODEL=muse-spark-1.3
QUALITY_CHECKER_FALLBACK_PROVIDER=XAI
QUALITY_CHECKER_FALLBACK_MODEL=grok-4.6

# Second-best production routing (cheaper hot path, no Astra):
# REASONER_PROVIDER=OPENAI
# REASONER_MODEL=gpt-5.6-sol
# REASONER_FALLBACK_PROVIDER=XAI
# REASONER_FALLBACK_MODEL=grok-4.6
# WORKHORSE_PROVIDER=GOOGLE
# WORKHORSE_MODEL=gemini-3.8-flash
# WORKHORSE_FALLBACK_PROVIDER=XAI
# WORKHORSE_FALLBACK_MODEL=grok-4.6
# QUALITY_CHECKER_PROVIDER=XAI
# QUALITY_CHECKER_MODEL=grok-4.6
# QUALITY_CHECKER_FALLBACK_PROVIDER=OPENAI
# QUALITY_CHECKER_FALLBACK_MODEL=gpt-5.6-terra

# Required by the long-lived Railway server. PostgreSQL is the content-free
# authoritative control plane; Redis holds deadline-bounded transient content.
DATABASE_URL=
REDIS_URL=

# Optional: remote reference Knowledge Base stored in Vercel Blob for this
# repository only. Do not point this at FinOps Engine services or blobs.
BLOB_READ_WRITE_TOKEN=
LZ_KB_BLOB_PREFIX=Landing Zone Knowledge Base/

# Server port — Railway and similar hosts set this automatically.
PORT=3000
